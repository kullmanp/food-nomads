# Copy to .env next to compose.yaml and fill in. .env is not committed.

# The image to run: the full commit sha of a green main commit (CI pushes one tag per commit).
# deploy.sh updates this line.
APP_VERSION=

# Where Members reach the app. Also the passkey origin, so it must match exactly.
BASE_URL=https://nomads.kup.ch

# Database password. See 1Password: "nomads app".
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts the session cookie. Changing it logs everyone out. See 1Password: "nomads app".
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
